# CI workflow template.
#
# Propagated by bootstrap to .claude/ci/ci.yml.template, and turned into a real
# .github/workflows/ci.yml by the owner-run setup-project.sh. It stays a template
# in THIS repo because this repo's own CI is guards.yml + secret-scan.yml; it is a
# template for consumers, not an inert file nobody runs.

name: CI

on:
  pull_request:
    branches: [main, develop]
  push:
    branches: [main]

jobs:
  lint-and-test:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Hallucinated-dependency guard (import existence)
        # Flags imports of packages not declared in the dependency manifest —
        # the slopsquatting signal. Detects the ecosystem at RUNTIME and skips
        # LOUDLY (visible in the log) if there is no adapter, so a propagated
        # guard never turns into a silent pass. Installed by bootstrap.
        run: |
          if [ -f .claude/ci/check-imports.mjs ]; then
            node .claude/ci/check-imports.mjs .
          else
            echo "WARNING: import guard not installed (.claude/ci/check-imports.mjs missing)"
            echo "         no hallucinated-dependency check ran — re-run bootstrap to install it"
          fi

      - name: Lint
        run: npm run lint

      - name: Test
        run: npm test

      - name: Build
        run: npm run build --if-present

  # NOTE: an `agent-checks` job used to live here, validating frontmatter in
  # .claude/agents/. That layer was retired in ADR-0003 and the directory is empty,
  # so the job could only ever skip — a step that always passes because it never
  # runs is worse than absent: it reads as coverage. Removed rather than propagated.

  project-checks:
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'

    steps:
      - uses: actions/checkout@v4

      - name: Check bilingual completeness
        run: |
          if [ -d src/locales ]; then
            en_keys=$(cat src/locales/en/translation.json | python3 -c "
          import json, sys
          data = json.load(sys.stdin)
          def get_keys(d, prefix=''):
              keys = []
              for k, v in d.items():
                  full = f'{prefix}.{k}' if prefix else k
                  if isinstance(v, dict):
                      keys.extend(get_keys(v, full))
                  else:
                      keys.append(full)
              return keys
          print('\n'.join(get_keys(data)))
          " | sort)
            de_keys=$(cat src/locales/de/translation.json | python3 -c "
          import json, sys
          data = json.load(sys.stdin)
          def get_keys(d, prefix=''):
              keys = []
              for k, v in d.items():
                  full = f'{prefix}.{k}' if prefix else k
                  if isinstance(v, dict):
                      keys.extend(get_keys(v, full))
                  else:
                      keys.append(full)
              return keys
          print('\n'.join(get_keys(data)))
          " | sort)
            diff <(echo "$en_keys") <(echo "$de_keys") && echo "Locales in sync" || (echo "Locale mismatch detected" && exit 1)
          else
            echo "No locales directory — skipping bilingual check"
          fi
